# Release signing — never commit real values here.
#
# Local builds: create keystore/release.keystore (gitignored) and export:
#   TUNEPLAYER_STORE_FILE=/abs/path/to/release.keystore
#   TUNEPLAYER_STORE_PASSWORD=...
#   TUNEPLAYER_KEY_ALIAS=...
#   TUNEPLAYER_KEY_PASSWORD=...
#
# CI: the same values come from repository secrets and the keystore is
# decoded from TUNEPLAYER_KEYSTORE_BASE64.
storeFile=
storePassword=
keyAlias=
keyPassword=
